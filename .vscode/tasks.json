{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar archivo C actual",
            "type": "shell",
            "command": "mkdir -p \"${fileDirname}/build\" && gcc -Wall -Wextra -g \"${file}\" -o \"${fileDirname}/build/${fileBasenameNoExtension}\" -lm",
            "windows": {
                "options": {
                    "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] }
                },
                "command": "if not exist \"${fileDirname}\\build\" mkdir \"${fileDirname}\\build\" && C:\\msys64\\ucrt64\\bin\\gcc.exe -Wall -Wextra -g \"${file}\" -o \"${fileDirname}\\build\\${fileBasenameNoExtension}.exe\""
            },
            "options": { "cwd": "${fileDirname}" },
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true }
        }
    ]
}
